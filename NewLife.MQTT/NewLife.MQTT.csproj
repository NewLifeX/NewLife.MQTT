<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net45;net461;netstandard2.0;netstandard2.1;net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyTitle>新生命MQTT协议</AssemblyTitle>
    <Description>纯国产自主MQTT 3.1/3.1.1/5.0完整协议实现，MqttClient客户端与MqttServer服务端一体化。六种传输TCP/TLS/WebSocket/WSS/QUIC/UDP；内置集群、桥接、规则引擎、WebHook、ACL、$SYS等企业功能免费；零第三方依赖，MIT开源，信创合规</Description>
    <Company>新生命开发团队</Company>
    <Copyright>版权所有(C) 新生命开发团队 2002~2026</Copyright>
    <VersionPrefix>3.2</VersionPrefix>
    <VersionSuffix>$([System.DateTime]::Now.ToString(`yyyy.MMdd`))</VersionSuffix>
    <Version>$(VersionPrefix).$(VersionSuffix)</Version>
    <FileVersion>$(Version)</FileVersion>
    <AssemblyVersion>$(VersionPrefix).*</AssemblyVersion>
    <Deterministic>false</Deterministic>
    <OutputPath>..\Bin</OutputPath>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\Doc\newlife.snk</AssemblyOriginatorKeyFile>
    <AnalysisLevel>latest</AnalysisLevel>
    <WarningsAsErrors>CA2007</WarningsAsErrors>
  </PropertyGroup>

  <!-- QUIC 预览功能：.NET 7/8 需启用，.NET 9+ 已稳定 -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net7.0' Or '$(TargetFramework)' == 'net8.0'">
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <NoWarn>$(NoWarn);CA2252</NoWarn>
  </PropertyGroup>

  <!-- net8.0+ 常驻启用 AOT/裁剪分析器：0 告警成为构建期硬约束，与 AOT 支持基线一致（CI 见 .github/workflows/aot.yml）。
       注意 SDK 会将 IsTrimmable 一并置真，这些目标的程序集会嵌入 IsTrimmable 元数据 -->
  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>$(AssemblyName)</PackageId>
    <Authors>$(Company)</Authors>
    <ProjectUrl>https://newlifex.com/core/mqtt</ProjectUrl>
    <PackageIcon>leaf.png</PackageIcon>
    <RepositoryUrl>https://github.com/NewLifeX/NewLife.MQTT</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>新生命团队;X组件;NewLife;$(AssemblyName);MQTT;MQTTClient;MQTTServer;MQTTBroker;IoT;物联网;MQTT5;QoS;PubSub;WebSocket;QUIC;TLS;集群;桥接;规则引擎;信创;MQTT-SN;OAuth;SOCKS5;持久化;存储;WebHook</PackageTags>
    <PackageReleaseNotes>适配 NewLife.Core v12：帧编解码迁移到 v12 消息泵（MqttFrame/MqttCodec 实现 IMessageCodec+IMessageMatcher）；WebSocket 改由独立 HttpServer + MqttWebSocketHandler 桥接（EnableWebSocket/WebSocketPort/WebSocketPath，不再与 TCP 端口共用）；管理 API 迁移到 HttpServer 控制器（地址保持 /Api/{Action}）；集群 RPC 迁移到 HTTP（ClusterPort 为 HTTP 端口，ClusterSecret 作为请求令牌）；移除 NewLife.Remoting 依赖。集群能力全面升级：Raft 共识引擎、一致哈希主题分片、分层集群路由、热点主题检测；新增 NewLife.MQTT.Storage 存储库，Redis+Database 双实现离线消息与会话持久化；新增 MQTT-SN v1.2 协议支持；新增 OAuth 认证与 SOCKS5 代理，安全增强（限速/黑白名单/JWT）；WebHook 六种事件集成至 MqttHandler+Exchange 管线；修复 6 种 MQTT 5.0 消息类型属性序列化缺陷；新增集群路由/Raft/热点检测等单元测试</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>Readme.MD</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="WebSocket\**" />
    <EmbeddedResource Remove="WebSocket\**" />
    <None Remove="WebSocket\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Handlers\MqttHandler.cs" />
    <Compile Remove="Handlers\MqttTypeAttribute.cs" />
    <Compile Remove="Models\PruningRadixTrie.cs" />
    <Compile Remove="Models\SubscriptionManager.cs" />
    <Compile Remove="Models\Trie.cs" />
    <Compile Remove="Models\TrieNode.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Doc\leaf.png" Link="leaf.png" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\Readme.MD">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NewLife.Core" Version="12.0.2026.1018-beta1517" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Models\" />
  </ItemGroup>
</Project>
