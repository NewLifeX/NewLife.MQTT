<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net45;net461;netstandard2.0;netstandard2.1;net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyTitle>NewLife.MQTT - MQTT Protocol Library</AssemblyTitle>
    <Description>Pure managed MQTT 3.1/3.1.1/5.0 client and server with six transports, clustering, bridging, rule engine, WebHook, ACL and $SYS. Zero third-party dependencies, MIT licensed.</Description>
    <Company>新生命开发团队</Company>
    <Copyright>版权所有(C) 新生命开发团队 2002~2026</Copyright>
    <VersionPrefix>4.0</VersionPrefix>
    <VersionSuffix>$([System.DateTime]::Now.ToString(`yyyy.MMdd`))</VersionSuffix>
    <Version>$(VersionPrefix).$(VersionSuffix)</Version>
    <FileVersion>$(Version)</FileVersion>
    <AssemblyVersion>$(VersionPrefix).*</AssemblyVersion>
    <Deterministic>false</Deterministic>
    <OutputPath>..\Bin</OutputPath>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\Doc\newlife.snk</AssemblyOriginatorKeyFile>
    <AnalysisLevel>latest</AnalysisLevel>
    <WarningsAsErrors>CA2007</WarningsAsErrors>
  </PropertyGroup>

  <!-- QUIC 预览功能：.NET 7/8 需启用，.NET 9+ 已稳定 -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net7.0' Or '$(TargetFramework)' == 'net8.0'">
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <NoWarn>$(NoWarn);CA2252</NoWarn>
  </PropertyGroup>

  <!-- net8.0+ 常驻启用 AOT/裁剪分析器：0 告警成为构建期硬约束，与 AOT 支持基线一致（CI 见 .github/workflows/aot.yml）。
       注意 SDK 会将 IsTrimmable 一并置真，这些目标的程序集会嵌入 IsTrimmable 元数据 -->
  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>$(AssemblyName)</PackageId>
    <Authors>$(Company)</Authors>
    <ProjectUrl>https://newlifex.com/core/mqtt</ProjectUrl>
    <PackageIcon>leaf.png</PackageIcon>
    <RepositoryUrl>https://github.com/NewLifeX/NewLife.MQTT</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>新生命团队;X组件;NewLife;$(AssemblyName);MQTT;MQTTClient;MQTTServer;MQTTBroker;IoT;物联网;MQTT5;QoS;PubSub;WebSocket;QUIC;TLS;集群;桥接;规则引擎;信创;MQTT-SN;OAuth;SOCKS5;持久化;存储;WebHook;本地化;localization;EventBus;事件总线;NativeAOT</PackageTags>
    <PackageDescription>Pure managed MQTT 3.1/3.1.1/5.0 client and server with six transports, clustering, bridging, rule engine, WebHook, ACL and $SYS. Zero third-party dependencies, MIT licensed. 纯托管 MQTT 3.1/3.1.1/5.0 客户端与服务端，支持六种传输（TCP/TLS/WebSocket/WSS/QUIC/UDP）以及集群、桥接、规则引擎、WebHook、ACL 和 $SYS；零第三方依赖，MIT 许可。</PackageDescription>
    <PackageReleaseNotes>大版本升级：适配 NewLife.Core 12（v12 网络栈，基于 Core v11 编译的调用方需重新编译）；WebSocket 改为独立 HttpServer（EnableWebSocket/WebSocketPort/WebSocketPath，不再共用 TCP 端口）；集群 RPC 改为 HTTP（ClusterPort 为 HTTP 端口，ClusterSecret 作为请求令牌），移除 NewLife.Remoting 依赖；新增基于 MQTT 主题的事件总线（默认广播订阅、可选共享订阅）；运行时消息、程序集元数据与服务端看板完成 31 种语言本地化；主题路由改为前缀索引与零分配匹配，Broker 收包约 125 万 msg/s、单连接端到端 QoS0 约 10.6 万 msg/s；NativeAOT 主链路 19 个场景 JIT/AOT 双跑通过，库侧 0 条 ILC 告警；修复链式帧体解码截断、QUIC 服务端会话、管理 API 断开、集群分片路由与订阅 RPC 绑定、Storage 离线消息查询等缺陷</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="WebSocket\**" />
    <EmbeddedResource Remove="WebSocket\**" />
    <None Remove="WebSocket\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Handlers\MqttHandler.cs" />
    <Compile Remove="Handlers\MqttTypeAttribute.cs" />
    <Compile Remove="Models\PruningRadixTrie.cs" />
    <Compile Remove="Models\SubscriptionManager.cs" />
    <Compile Remove="Models\Trie.cs" />
    <Compile Remove="Models\TrieNode.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Doc\leaf.png" Link="leaf.png" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.nuget.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NewLife.Core" Version="12.0.2026.1024" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Models\" />
  </ItemGroup>
</Project>
